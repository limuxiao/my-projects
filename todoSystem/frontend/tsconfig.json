{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    // 显式声明全局类型库，阻止 TS 隐式扫描 node_modules/@types 下所有包
    // 避免传递依赖里残缺的隐式类型库（如 prop-types）触发 "找不到类型定义文件" 报错
    // 项目所需类型均通过 import 或 lib 获得，无需任何全局注入
    "types": [],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src"]
}
