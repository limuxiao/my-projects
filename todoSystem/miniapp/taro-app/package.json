{
  "name": "todosystem-taro-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "todoSystem 微信小程序（Taro 4 + React + TypeScript）",
  "scripts": {
    "patch:nutui": "node scripts/patch-nutui-wxss.js",
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp && npm run patch:nutui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nutui/icons-react-taro": "^4.1.0",
    "@nutui/nutui-react-taro": "^4.0.0",
    "@tarojs/components": "^4.1.0",
    "@tarojs/plugin-framework-react": "^4.1.0",
    "@tarojs/react": "^4.1.0",
    "@tarojs/runtime": "^4.1.0",
    "@tarojs/taro": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "^4.1.0",
    "@tarojs/plugin-platform-weapp": "^4.1.0",
    "@tarojs/webpack5-runner": "^4.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "babel-preset-taro": "^4.1.0",
    "sass": "^1.77.0",
    "typescript": "^5.4.0"
  }
}
