# 部署环境变量示例：复制为 .env.deploy 后按实际情况修改
# docker compose 会自动读取同目录的 .env.deploy（通过 compose 命令 --env-file 指定）

# 前端对外端口（浏览器访问 http://服务器IP:${FRONTEND_PORT}）
FRONTEND_PORT=8001

# MySQL 对宿主机暴露的端口（数据库客户端连接用）
DB_PORT=3307

# 数据库
DB_NAME=todosystem
DB_USER=todosystem
DB_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# JWT 签名密钥（务必改成随机长字符串）
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
